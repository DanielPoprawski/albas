{
      "$schema": "https://schema.tauri.app/config/2",
      "productName": "albas",
      "version": "1.10.0",
      "identifier": "dev.daniel-p.albas",
      "build": {
            "beforeDevCommand": "bun run dev",
            "devUrl": "http://localhost:1420",
            "beforeBuildCommand": "bun run build",
            "frontendDist": "../dist"
      },
      "app": {
            "windows": [
                  {
                        "title": "Albas",
                        "width": 1400,
                        "height": 900
                  }
            ],
            "security": {
                  "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
            }
      },
      "bundle": {
            "active": true,
            "targets": ["deb", "rpm"],
            "icon": [
                  "icons/32x32.png",
                  "icons/128x128.png",
                  "icons/128x128@2x.png",
                  "icons/icon.icns",
                  "icons/icon.ico"
            ]
      }
}
