# Copy to keystore.properties (gitignored) and fill in after creating the key:
#
#   keytool -genkey -v -keystore ~/.android/albas-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias albas
#
# Without keystore.properties the release build stays unsigned and installs
# nowhere; the debug build is unaffected either way.
#
# Losing this keystore means no more in-place upgrades of an installed release
# build — a different key forces an uninstall, which deletes the SQLite database.
storeFile=/home/daniel/.android/albas-release.jks
storePassword=
keyAlias=albas
keyPassword=
